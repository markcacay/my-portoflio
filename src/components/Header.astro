---
const links = [['Work', '/work/'], ['About', '/about/'], ['Contact', '/contact/']];
const path = Astro.url.pathname;
---
<header class="wrap site-header">
  <a class="wordmark" href="/">Mark Cacay</a>
  <nav aria-label="Main">
    <details class="menu">
      <summary class="label">Menu</summary>
      <ul>
        {links.map(([l, h]) => <li><a href={h} aria-current={path.startsWith(h) ? 'page' : undefined}>{l}</a></li>)}
        <li class="nav-cta"><a class="btn btn-primary" href="/contact/">Start a project</a></li>
      </ul>
    </details>
  </nav>
</header>
<style>
  .site-header { display: flex; align-items: center; justify-content: space-between; padding-block: 20px; position: relative; }
  .wordmark { font: 600 22px/1 var(--font-display); color: var(--color-ink); text-decoration: none; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 40px; }
  ul a:not(.btn) { color: var(--color-ink); text-decoration: none; font-weight: 500; font-size: 15px; }
  ul a[aria-current='page'] { text-decoration: underline; }
  summary { display: none; list-style: none; cursor: pointer; border: 1.5px solid var(--color-ink); border-radius: var(--radius-pill); padding: 10px 16px; }
  summary::-webkit-details-marker { display: none; }
  /* Desktop: links always visible regardless of <details> open state */
  @media (min-width: 761px) { .menu > ul { display: flex !important; } }
  @media (max-width: 760px) {
    summary { display: block; }
    .menu:not([open]) > ul { display: none; }
    .menu[open] > ul { position: absolute; right: var(--gutter); top: 64px; z-index: 5; flex-direction: column; align-items: stretch; gap: 0; background: var(--color-white); padding: 8px; border-radius: var(--radius-panel); box-shadow: 0 8px 24px rgb(24 33 43 / 0.12); min-width: 220px; }
    .menu[open] li a:not(.btn) { display: block; padding: 14px 16px; }
    .nav-cta { padding: 8px; }
  }
</style>
