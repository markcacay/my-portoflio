---
import LogoMark from './LogoMark.astro';
const links = [['Work', '/work/'], ['About', '/about/'], ['Contact', '/contact/']];
const path = Astro.url.pathname;
const { dark = false } = Astro.props as { dark?: boolean };
---
<div class:list={['header-band', { 'on-dark': dark }]}>
<header class="wrap site-header">
  <a class="wordmark" href="/" aria-label="Mark Cacay, home"><LogoMark size={32} /><span>Mark Cacay</span></a>
  <nav aria-label="Main" class="desktop">
    <ul class="desktop-list">
      {links.map(([l, h]) => <li><a href={h} aria-current={path.startsWith(h) ? 'page' : undefined}>{l}</a></li>)}
      <li><a class="btn btn-primary" href="/contact/">Start a project</a></li>
    </ul>
  </nav>
  <details class="mobile">
    <summary class="label">Menu</summary>
    <nav aria-label="Main">
      <ul>
        {links.map(([l, h]) => <li><a href={h} aria-current={path.startsWith(h) ? 'page' : undefined}>{l}</a></li>)}
        <li class="nav-cta"><a class="btn btn-primary" href="/contact/">Start a project</a></li>
      </ul>
    </nav>
  </details>
</header>
</div>
<style>
  .header-band.on-dark { background: var(--color-ink); }
  .on-dark .wordmark, .on-dark ul.desktop-list a:not(.btn) { color: var(--color-white); }
  .on-dark summary { border-color: var(--color-paper); color: var(--color-white); }
  .site-header { display: flex; align-items: center; justify-content: space-between; padding-block: 20px; position: relative; }
  .wordmark { display: inline-flex; align-items: center; gap: 10px; font: 700 22px/1 var(--font-display); letter-spacing: -0.02em; color: var(--color-ink); text-decoration: none; }
  .on-dark .wordmark { --logo-dot: #5B7CFF; }
  ul { list-style: none; margin: 0; padding: 0; }
  .desktop ul { display: flex; align-items: center; gap: 40px; }
  ul a:not(.btn) { color: var(--color-ink); text-decoration: none; font-weight: 500; font-size: 15px; }
  ul a[aria-current='page'] { text-decoration: underline; }
  summary { list-style: none; cursor: pointer; border: 1.5px solid var(--color-ink); border-radius: var(--radius-pill); padding: 10px 16px; }
  summary::-webkit-details-marker { display: none; }
  .mobile { display: none; }
  .mobile nav { position: absolute; right: var(--gutter); top: 64px; z-index: 5; background: var(--color-white); padding: 8px; border-radius: var(--radius-panel); box-shadow: 0 8px 24px rgb(24 33 43 / 0.12); min-width: 220px; }
  .mobile li a:not(.btn) { display: block; padding: 14px 16px; }
  .nav-cta { padding: 8px; }
  @media (max-width: 760px) { .desktop { display: none; } .mobile { display: block; } }
</style>
