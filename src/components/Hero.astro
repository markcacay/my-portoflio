---
import { Image } from 'astro:assets';
import CtaPair from './CtaPair.astro';
import poster from '../assets/portrait-poster.png';
---
<section id="hero" class="hero-dark on-dark" data-hero>
  <div class="wrap hero">
    <div class="intro">
      <h1>I build fast WordPress sites and connect them to the tools your business runs on.</h1>
      <p class="lede">Figma-to-WordPress builds, WooCommerce stores and custom integrations with GoHighLevel, HubSpot and Klaviyo. 15+ years building for small businesses in Australia and the US.</p>
      <CtaPair />
    </div>
    <div class="slot" data-portrait-slot>
      <Image class="poster" src={poster} alt="Mark Cacay, standing, drawn in points of light" widths={[240, 480, 720]} sizes="(min-width: 900px) 360px, 240px" loading="eager" fetchpriority="high" />
    </div>
  </div>
</section>
<script>
  import { shouldRun3D, detectEnv, mountHero } from '../scripts/hero-scene';
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const slot = document.querySelector<HTMLElement>('[data-portrait-slot]');
  const env = detectEnv();
  if (hero && slot && shouldRun3D(env)) {
    // Start on the visitor's first interaction, so the 3D never competes with loading the page.
    const events = ['pointermove', 'pointerdown', 'keydown', 'wheel', 'scroll', 'touchstart'] as const;
    const go = () => {
      events.forEach((e) => removeEventListener(e, go));
      mountHero(hero, slot, env).catch(() => { /* keep the poster */ });
    };
    events.forEach((e) => addEventListener(e, go, { once: true, passive: true }));
  }
</script>
<style>
  .hero-dark { position: relative; overflow: hidden; background: var(--color-ink); color: var(--color-white); }
  .hero { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 32px; align-items: end; min-height: min(calc(100svh - 88px), 860px); padding-top: 40px; }
  .intro { display: grid; gap: 28px; align-self: center; padding-bottom: 64px; }
  .intro h1 { color: var(--color-white); }
  .intro .lede { color: var(--color-mist); max-width: 34em; }
  .slot { align-self: stretch; display: flex; align-items: flex-end; justify-content: center; min-height: 520px; }
  .poster { height: 100%; max-height: 780px; width: auto; object-fit: contain; object-position: bottom; transition: opacity 0.8s ease; }
  .hero-dark:global(.is-3d) .poster { opacity: 0; }
  .hero-dark :global(.portrait-canvas) { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; opacity: 0; transition: opacity 0.8s ease; pointer-events: none; }
  .hero-dark:global(.is-3d) :global(.portrait-canvas) { opacity: 1; }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; min-height: 0; }
    .intro { padding-bottom: 8px; }
    .slot { height: 520px; min-height: 0; }
  }
</style>
